{
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "routes": [
    {
      "src": "^/diary(?:/(.*))?$",
      "has": [{ "type": "header", "key": "x-vercel-ip-country", "value": "FR" }],
      "dest": "/diary/$1"
    },
    {
      "src": "^/diary(?:/(.*))?$",
      "has": [{ "type": "header", "key": "x-vercel-ip-country", "value": "BE" }],
      "dest": "/diary/$1"
    },
    {
      "src": "^/diary(?:/.*)?$",
      "status": 403,
      "dest": "/diary-blocked.html"
    }
  ]
}
