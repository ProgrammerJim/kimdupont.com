{
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "routes": [
    {
      "src": "^/diary(?:/.*)?$",
      "has": [
        { "type": "header", "key": "x-vercel-ip-country", "value": "FR" }
      ],
      "continue": true
    },
    {
      "src": "^/diary(?:/.*)?$",
      "status": 403,
      "dest": "/diary-blocked.html"
    }
  ]
}
